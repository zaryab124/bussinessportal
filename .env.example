# Application Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# CRITICAL: Replace with a cryptographically secure 64+ char secret in production
JWT_SECRET=super_secret_jwt_key_replace_in_production_998877112233445566
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# Database Configuration
# Remote PostgreSQL connection string (e.g., Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/stock_portal?sslmode=require
# If DATABASE_URL is empty, embedded persistent PostgreSQL (@electric-sql/pglite) is used:
DATABASE_URL=
DATA_DIR=./data/postgres

# Media Uploads Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
